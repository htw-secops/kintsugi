{
  "name": "Windows workstation (Master Daily)",
  "items": [
    {
      "key": "gdrive.allowed-accounts-pattern",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Google\\DriveFS",
      "valueName": "AllowedAccountsPattern",
      "valueType": "string",
      "data": ".*@htw.com.au",
      "mode": "audit",
      "reason": "Master Daily section 1: Google Drive for desktop signs in only with company accounts."
    },
    {
      "key": "chrome.cloud-management-enrollment-token",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Google\\Chrome",
      "valueName": "CloudManagementEnrollmentToken",
      "valueType": "string",
      "secret": "CHROME_ENROLLMENT_TOKEN",
      "mode": "audit",
      "reason": "Master Daily section 2: enrols Chrome in Chrome Browser Cloud Management. The value is a secret (Ninja custom field chromeEnrollement); secrets are a later step, so agents report this item not-applicable and never read it."
    },
    {
      "key": "ms-account.allow-your-account",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Microsoft\\PolicyManager\\default\\Settings",
      "valueName": "AllowYourAccount",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 3: blocks adding a Microsoft account in Settings."
    },
    {
      "key": "ms-account.allow-sign-in-options",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Microsoft\\PolicyManager\\default\\Settings",
      "valueName": "AllowSignInOptions",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 3: hides sign-in options. CONFLICT: section 12 sets AllowSignInOptions to 1 through PolicyManager\\default\\Settings\\AllowSignInOptions\\value. Resolve before step 3 enforces either."
    },
    {
      "key": "ms-account.no-connected-user",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
      "valueName": "NoConnectedUser",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 3: users can't add Microsoft accounts (Accounts: Block Microsoft accounts)."
    },
    {
      "key": "onedrive.disable-file-sync",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\OneDrive",
      "valueName": "DisableFileSyncNGSC",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 4: OneDrive can't sync files. The OneDrive removal itself is a software rule in a later step."
    },
    {
      "key": "onedrive.hide-from-navigation-pane",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Classes\\CLSID\\{018D5C66-4533-4307-9B53-224DE2ED1FE6}",
      "valueName": "System.IsPinnedToNameSpaceTree",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 4: hides OneDrive in File Explorer. Ninja writes HKCR as SYSTEM, which lands here; a per-user OneDrive registers the same CLSID in the user's own classes, which wins for that user."
    },
    {
      "key": "store.remove-windows-store",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\WindowsStore",
      "valueName": "RemoveWindowsStore",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 5: turns off the Microsoft Store app."
    },
    {
      "key": "power.fast-startup-off",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
      "valueName": "HiberbootEnabled",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 6: Fast Startup off, so a shutdown is a real one and pending updates apply."
    },
    {
      "key": "copilot.windows-ai-turn-off",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsAI",
      "valueName": "TurnOffWindowsCopilot",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 7: Windows Copilot off (the WindowsAI path)."
    },
    {
      "key": "copilot.turn-off",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\WindowsCopilot",
      "valueName": "TurnOffWindowsCopilot",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 7: Windows Copilot off (the WindowsCopilot policy path)."
    },
    {
      "key": "copilot.hide-taskbar-button",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Explorer",
      "valueName": "HideCopilotButton",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 7: hides the Copilot button on the taskbar."
    },
    {
      "key": "edge.allow-copilot-off",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Edge",
      "valueName": "AllowCopilot",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 7: Copilot off in Edge."
    },
    {
      "key": "edge.sidebar-off",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Edge",
      "valueName": "HubsSidebarEnabled",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 7: Edge sidebar (where Copilot lives) off."
    },
    {
      "key": "lock.max-inactivity-device-lock",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Microsoft\\PolicyManager\\default\\DeviceLock\\MaxInactivityTimeDeviceLock",
      "valueName": "value",
      "valueType": "dword",
      "data": "600",
      "mode": "audit",
      "reason": "Master Daily section 8: device locks after 10 minutes idle (DeviceLock CSP)."
    },
    {
      "key": "lock.max-inactivity-duration",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System",
      "valueName": "MaxInactivityDuration",
      "valueType": "dword",
      "data": "600",
      "mode": "audit",
      "reason": "Master Daily section 8: 10-minute inactivity limit, second path."
    },
    {
      "key": "lock.device-password-enabled",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Microsoft\\PolicyManager\\default\\DeviceLock\\DevicePasswordEnabled",
      "valueName": "value",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 8.1: device password required (in this CSP 0 means enabled)."
    },
    {
      "key": "wake.password-on-ac",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Power\\PowerSettings\\0e796bdb-5952-4e82-9c48-3d5f20595d87",
      "valueName": "ACSettingIndex",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 9: password on wake, plugged in."
    },
    {
      "key": "wake.password-on-battery",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Power\\PowerSettings\\0e796bdb-5952-4e82-9c48-3d5f20595d87",
      "valueName": "DCSettingIndex",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 9: password on wake, on battery."
    },
    {
      "key": "telemetry.allow-telemetry",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection",
      "valueName": "AllowTelemetry",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 11: diagnostic data at its lowest level."
    },
    {
      "key": "hello.enabled",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\PassportForWork",
      "valueName": "Enabled",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 12: Windows Hello for Business on."
    },
    {
      "key": "hello.require-security-device",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\PassportForWork",
      "valueName": "RequireSecurityDevice",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 12: Hello keys must live in the TPM."
    },
    {
      "key": "hello.post-logon-provisioning",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\PassportForWork",
      "valueName": "DisablePostLogonProvisioning",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 12: Hello set-up is offered after sign-in."
    },
    {
      "key": "hello.pin-minimum-length",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\PassportForWork\\PINComplexity",
      "valueName": "MinimumPINLength",
      "valueType": "dword",
      "data": "6",
      "mode": "audit",
      "reason": "Master Daily section 12: PIN at least 6 digits."
    },
    {
      "key": "hello.pin-digits",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\PassportForWork\\PINComplexity",
      "valueName": "Digits",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 12: PIN must contain digits."
    },
    {
      "key": "hello.pin-expiration",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\PassportForWork\\PINComplexity",
      "valueName": "Expiration",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 12: PIN never expires."
    },
    {
      "key": "hello.pin-history",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\PassportForWork\\PINComplexity",
      "valueName": "History",
      "valueType": "dword",
      "data": "0",
      "mode": "audit",
      "reason": "Master Daily section 12: no PIN history."
    },
    {
      "key": "biometrics.enabled",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Biometrics",
      "valueName": "Enabled",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 12: biometrics allowed."
    },
    {
      "key": "biometrics.allow-domain-logon",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Biometrics",
      "valueName": "AllowDomainLogon",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 12: biometric sign-in for domain users."
    },
    {
      "key": "biometrics.face-enabled",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Biometrics\\FacialFeatures",
      "valueName": "Enabled",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 12: face recognition allowed."
    },
    {
      "key": "biometrics.face-enhanced-anti-spoofing",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Biometrics\\FacialFeatures",
      "valueName": "EnhancedAntiSpoofing",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 12: enhanced anti-spoofing for face."
    },
    {
      "key": "hello.allow-sign-in-options",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Microsoft\\PolicyManager\\default\\Settings\\AllowSignInOptions",
      "valueName": "value",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 12: shows sign-in options. CONFLICT: section 3 sets AllowSignInOptions to 0 through PolicyManager\\default\\Settings. Resolve before step 3 enforces either."
    },
    {
      "key": "hello.allow-domain-pin-logon",
      "kind": "setting",
      "scope": "machine",
      "hive": "HKLM",
      "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\System",
      "valueName": "AllowDomainPINLogon",
      "valueType": "dword",
      "data": "1",
      "mode": "audit",
      "reason": "Master Daily section 12: PIN sign-in for domain users."
    }
  ]
}
